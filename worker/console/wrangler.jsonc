/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "tokscale-serverless-console",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-09-16",
	// Serve through a dashboard-managed custom domain protected by Access.
	// Disable alternate public entry points that could bypass that policy.
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// Browser API queries are proxied through the service binding.
		// Installation and uploads use the PUBLIC_API_URL build variable.
		"run_worker_first": ["/api", "/api/*"]
	},
	"services": [
		{
			"binding": "API",
			"service": "tokscale-serverless-api"
		}
	]
	// Custom domains are managed in the Cloudflare dashboard.
	// Leave route/routes unset so deployment does not declare domain bindings.
	// Secrets: INGEST_TOKEN (same shared token as the api worker) — set with
	// `npx wrangler secret put INGEST_TOKEN --config console/wrangler.jsonc`.
	// Used only to authorize server-side read proxies until Access fronts this
	// worker.
}
